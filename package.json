{
  "name": "hsc-physics-solver",
  "private": true,
  "version": "1.0.0",
  "description": "NSW HSC Physics (Stage 6, 2017 syllabus) deterministic mathematical solver for Modules 5-8",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "katex": "^0.18.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/katex": "^0.16.8",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^25.0.1",
    "typescript": "5.6",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  }
}
